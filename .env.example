# Copy to .env.local and fill in once providers are chosen/created (M2+).
# Never commit the real .env.local — it's already gitignored.

# Database + Auth — Supabase (M2, stack approved 2026-10-19)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Encryption key for learners.national_id_encrypted (app-layer pgcrypto, not stored in DB)
NATIONAL_ID_ENCRYPTION_KEY=

# Transactional email — "Generate User" credential delivery (M4)
# Domain is mhesi.go.th; DNS access unconfirmed, see docs/planning/13-risk-register.md R16
RESEND_API_KEY=
EMAIL_FROM=

# Object storage — unit photos, <=6/unit (M5). Using Supabase Storage — no separate
# credentials needed beyond the Supabase keys above; bucket name only.
STORAGE_BUCKET=unit-photos
